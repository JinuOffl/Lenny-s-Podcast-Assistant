# ─── Supabase ────────────────────────────────────────────────────────────────
# Get these from your Supabase project → Settings → Database → Connection string
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key

# Direct Postgres connection string (for psycopg / pgvector)
# Format: postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[your-password]@db.[your-project-ref].supabase.co:5432/postgres

# ─── LLM: Anthropic (cloud) ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# ─── LLM: Ollama (local, default) ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
# Change to any Ollama model you have pulled, e.g. llama3.3:8b, qwen3:4b
OLLAMA_CHAT_MODEL=llama3.3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── App settings ────────────────────────────────────────────────────────────
# Default provider on startup: "ollama" | "anthropic"
LLM_PROVIDER=ollama

# RAG settings
RAG_TOP_K=5
CHUNK_SIZE=700
CHUNK_OVERLAP=100
